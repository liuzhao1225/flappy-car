{
  "name": "flappy-car",
  "version": "1.0.0",
  "private": true,
  "description": "Pixel Roadster flying game with score cards, friends and rankings",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "build": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.cjs",
    "dev:api": "wrangler dev --local --port 8787 --inspector-port 9231",
    "deploy:api": "wrangler d1 migrations apply flappy-car --remote && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "@fontsource/fusion-pixel-12px-monospaced-sc": "5.3.0",
    "qrcode-generator": "1.4.4"
  }
}
