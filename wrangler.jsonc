{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flappy-car-api",
  "main": "api/worker.mjs",
  "account_id": "fd34f102f861414f76a9a7950b0627fb",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
